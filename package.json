{
  "name": "quickbooks-mcp",
  "version": "0.12.0",
  "description": "MCP server for QuickBooks Online API integration",
  "license": "MIT",
  "mcpName": "io.github.laf-rge/quickbooks-mcp",
  "author": "laf-rge",
  "homepage": "https://github.com/laf-rge/quickbooks-mcp",
  "bugs": "https://github.com/laf-rge/quickbooks-mcp/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/laf-rge/quickbooks-mcp.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "quickbooks-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "scripts/migrate-security.mjs"
  ],
  "scripts": {
    "build": "tsc",
    "eval:discovery": "node scripts/evaluate-discovery.mjs",
    "test": "tsc -p tsconfig.test.json && node --enable-source-maps --test \"dist-test/tests/**/*.test.js\"",
    "build:lambda": "node scripts/build-lambda.mjs",
    "security:migrate": "node scripts/migrate-security.mjs",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsc --watch"
  },
  "keywords": [
    "mcp",
    "quickbooks",
    "api",
    "accounting",
    "model-context-protocol"
  ],
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1131.0",
    "@aws-sdk/client-ssm": "^3.1131.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.2.3",
    "jose": "^6.2.12",
    "node-quickbooks": "^2.0.50",
    "tmp": "^0.2.7"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/tmp": "^0.2.6",
    "esbuild": "^0.28.2",
    "typescript": "^5.3.0"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "2.1.0"
  },
  "overrides": {
    "node-quickbooks": {
      "underscore": "1.13.8",
      "uuid": "11.1.1",
      "fast-xml-parser": "5.12.1"
    },
    "axios": {
      "follow-redirects": "1.16.3"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
